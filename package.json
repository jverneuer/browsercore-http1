{
  "name": "@browsercore/http1",
  "version": "0.1.2",
  "description": "HTTP/1.1 client over any duplex byte stream. No knowledge of TLS or TCP — only the protocol.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverneuer/browsercore-http1.git"
  },
  "homepage": "https://github.com/jverneuer/browsercore-http1#readme",
  "bugs": {
    "url": "https://github.com/jverneuer/browsercore-http1/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@browsercore/transport": "latest"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
